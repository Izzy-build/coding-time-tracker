# Copy to .env.local. Never commit .env.local.

# --- How the browser reaches the API -------------------------------------------------------------
# Leave NEXT_PUBLIC_API_URL EMPTY (recommended for local dev): the browser calls same-origin /api/v1/*
# and Next.js proxies it to BACKEND_URL, so the backend needs no CORS changes.
#
# Set it (e.g. http://127.0.0.1:3000) to make the browser call the backend DIRECTLY. Then the backend's
# CORS_ORIGINS must include this app's origin (e.g. http://localhost:3001) and it is baked in at build time.
NEXT_PUBLIC_API_URL=

# Server-side only: the Fastify backend origin used by the proxy. Read at BUILD time (set it before `npm run build`).
BACKEND_URL=http://127.0.0.1:3000
