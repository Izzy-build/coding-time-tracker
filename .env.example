# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://ctt:ctt_dev_pw@localhost:5432/ctt
DB_POOL_MAX=10

# REQUIRED: >= 32 random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=coding-time-tracker
# Website JWT lifetime in seconds (default 7 days; there is no refresh endpoint)
JWT_ACCESS_TTL_SECONDS=604800

# Comma-separated list of allowed browser origins (empty = CORS disabled)
CORS_ORIGINS=http://localhost:3000
# Set true only when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
# Serve Swagger UI at /docs and the spec at /docs/json
DOCS_ENABLED=true

# Rate limits (requests per minute, per client IP; in-memory, per process)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Largest number of seconds a single POST /api/v1/report may add (CLI sends ~300 every 5 minutes)
REPORT_MAX_SECONDS=3600
# Per-IP requests/minute for the CLI endpoints (validate, report, profile)
CLI_RATE_LIMIT_MAX=60

# Argon2id password hashing cost
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Used by `npm test` (database name must contain "test"; it is truncated between tests)
TEST_DATABASE_URL=postgres://ctt:ctt_dev_pw@localhost:5432/ctt_test
